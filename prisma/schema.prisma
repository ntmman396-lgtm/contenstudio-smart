generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  role        String
  password    String
  isActive    Boolean   @default(true)
  specialties String?
  capacity    Int?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]

  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Article {
  id                    String    @id @default(uuid())
  title                 String
  slug                  String    @unique
  sapo                  String?
  content               String?
  references            String?
  seoMeta               String?
  category              String?
  tags                  String?
  templateId            String
  templateName          String
  siteId                String    @default("nha-thuoc")
  status                String    @default("pending_review")
  createdAt             DateTime  @default(now())
  syncedAt              DateTime?
  rawFields             String?
  citationReport        String?
  citationVerification  String?
  workflowStatus        String    @default("draft")
  createdBy             String?
  assignedCtvId         String?
  assignedBsId          String?
  specialty             String?
  rejectionReason       String?
  revisionChecklist     String?
  inlineComments        String?
  revisionCount         Int       @default(0)
  ctaContent            String?
  publishedAt           DateTime?
  closedAt              DateTime?
  closedBy              String?
  assignedBy            String?
  approvedBy            String?
  qcScore               Float?
  qcGrade               String?
  qcBadge               String?
  qcAutoFixes           Int?      @default(0)
  qcManualIssues        Int?      @default(0)
  qcSyncBlocked         Boolean?  @default(false)
  qcBlockedBy           String?
  qcBlockedReason       String?
  qcLastRun             DateTime?
  qcTechScore           String?
  qcTechGrade           String?
  qcContentScore        String?
  qcContentGrade        String?
  qcContentReviewerNote String?
  qcRiskScore           Float?
  qcSafetyScore         Float?
  qcFinalSafetyIndex    Float?
  qcDecision            String?
  qcRiskLevel           String?
  qcFindings            String?

  @@index([status])
  @@index([workflowStatus])
  @@index([templateId])
  @@index([siteId])
  @@index([createdBy])
  @@index([assignedBsId])
  @@map("articles")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  siteId    String   @default("nha-thuoc")
  createdAt DateTime @default(now())

  @@unique([name, siteId])
  @@index([siteId])
  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  siteId    String   @default("nha-thuoc")
  createdAt DateTime @default(now())

  @@unique([name, siteId])
  @@index([siteId])
  @@map("tags")
}

model InternalLink {
  id        String   @id @default(uuid())
  anchor    String
  url       String
  siteId    String   @default("nha-thuoc")
  createdAt DateTime @default(now())

  @@unique([anchor, siteId])
  @@index([siteId])
  @@map("internal_links")
}

model Template {
  id                  String   @id
  name                String
  icon                String?
  stepCount           Int      @default(0)
  steps               String?
  estimatedWords      String?
  systemPrompt        String?
  outline             String?
  requiredFields      String?
  notes               String?
  sites               String?
  sitePromptOverrides String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("templates")
}

model KbSource {
  id            String    @id
  title         String
  sourceType    String
  scope         String?
  originUrl     String?
  filePath      String?
  extractedText String?
  fileSizeKb    Int?
  pageCount     Int?
  language      String?
  publisher     String?
  publishYear   Int?
  topicTags     String?
  templateTags  String?
  siteId        String    @default("nha-thuoc")
  status        String
  chunkCount    Int       @default(0)
  isActive      Boolean   @default(true)
  uploadedBy    String?
  createdAt     DateTime  @default(now())
  lastIndexedAt DateTime?
  errorMsg      String?

  @@index([siteId])
  @@map("kb_sources")
}

model KbChunk {
  id             String   @id
  sourceId       String
  chunkIndex     Int
  content        String
  contentLength  Int
  pageNumber     Int?
  sectionHeading String?
  metadata       String?
  createdAt      DateTime @default(now())

  @@index([sourceId])
  @@map("kb_chunks")
}

model KbCitationLog {
  id                String   @id @default(uuid())
  articleId         String
  articleTitle      String
  date              DateTime @default(now())
  totalCitations    Int      @default(0)
  kbCitations       Int      @default(0)
  externalCitations Int      @default(0)
  unverified        Int      @default(0)
  transparencyNotes String?
  status            String

  @@map("kb_citation_logs")
}

model QcRule {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String
  section        String
  subDimension   String
  deduction      Int
  maxDeduction   Int
  severity       String
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  autoFixable    Boolean  @default(false)
  fixInstruction String
  appliesTo      String
  checkType      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("qc_rules")
}

model WorkflowLog {
  id         String   @id @default(uuid())
  articleId  String
  action     String
  fromStatus String
  toStatus   String
  actorId    String
  actorName  String
  actorRole  String
  note       String?
  createdAt  DateTime @default(now())

  @@index([articleId])
  @@map("workflow_logs")
}
